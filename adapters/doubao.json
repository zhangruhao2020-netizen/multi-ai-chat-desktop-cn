{
  "$schema": "./schema.json",
  "schemaVersion": 2,
  "adapterVersion": 3,
  "provider": "doubao",
  "displayName": "Doubao",
  "urls": {
    "app": "https://www.doubao.com/chat",
    "login": "https://www.doubao.com/chat",
    "match": [
      "www.doubao.com/*",
      "doubao.com/*"
    ]
  },
  "inputSelectors": [
    "[contenteditable=\"true\"]",
    "[role=\"textbox\"]",
    "textarea"
  ],
  "sendButtonSelectors": [
    "button[aria-label=\"发送\"]",
    "button[aria-label=\"Send\"]",
    "button[type=\"submit\"]"
  ],
  "responseSelectors": [
    "div[data-testid=\"receive_message\"]",
    "[data-testid=\"message_content\"]",
    "[data-testid=\"message_text_content\"]",
    "[data-role=\"assistant\"]",
    "[class*=\"bot-message\"]",
    "[class*=\"markdown\"]"
  ],
  "loginDetectors": [
    "[contenteditable=\"true\"]",
    "[role=\"textbox\"]",
    "textarea",
    "button[aria-label=\"发送\"]"
  ],
  "loggedOutDetectors": [
    {
      "selector": "body",
      "textIncludes": "受区域限制",
      "detail": "region-restricted"
    },
    {
      "selector": "button",
      "textIncludes": "登录"
    },
    {
      "selector": "button",
      "textIncludes": "Log In"
    }
  ],
  "thinkingDetectors": [
    "button[aria-label=\"停止\"]",
    "button[aria-label=\"停止生成\"]",
    {
      "selector": "button",
      "textIncludes": "停止生成"
    }
  ],
  "stopButtonSelectors": [
    "button[aria-label=\"停止\"]",
    "button[aria-label=\"停止生成\"]"
  ],
  "inputStrategy": "default",
  "sendStrategy": "click",
  "timing": {
    "doneDelayMs": 5000,
    "chunkDebounceMs": 600,
    "statusIntervalMs": 10000,
    "backupPollMs": 3000
  }
}
